{
    "name": "code-tamagotchi",
    "displayName": "Code Tamagotchi",
    "description": "A digital pet that lives in your status bar. Feed it with commits, evolve it by refactoring, and keep it healthy by fixing linter errors.",
    "version": "0.1.0",
    "publisher": "davidfried007",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codeTamagotchi.showPet",
                "title": "Code Tamagotchi: Show Pet"
            },
            {
                "command": "codeTamagotchi.resetPet",
                "title": "Code Tamagotchi: Reset Pet"
            }
        ],
        "configuration": {
            "title": "Code Tamagotchi",
            "properties": {
                "codeTamagotchi.petName": {
                    "type": "string",
                    "default": "Tama",
                    "description": "Default name for your pet"
                },
                "codeTamagotchi.hungerRate": {
                    "type": "number",
                    "default": 12.5,
                    "description": "Hunger increase per hour (default: 12.5, starving in ~8h)"
                },
                "codeTamagotchi.commitFeedAmount": {
                    "type": "number",
                    "default": 30,
                    "description": "Hunger reduction per commit (default: 30)"
                },
                "codeTamagotchi.xpPerLine": {
                    "type": "number",
                    "default": 2,
                    "description": "XP gained per deleted line (default: 2)"
                },
                "codeTamagotchi.errorThreshold": {
                    "type": "number",
                    "default": 20,
                    "description": "Number of diagnostic errors before health starts decreasing (default: 20)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "node esbuild.js --production",
        "watch": "node esbuild.js --watch",
        "lint": "tsc --noEmit",
        "test": "jest"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "esbuild": "^0.20.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.3.0"
    }
}